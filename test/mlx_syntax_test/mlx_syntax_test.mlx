open Well_test

let render (`Html v : _ Html.node) = Html.element_to_string (`Html v)

let () =
  describe "Well MLX syntax" (fun () ->
    it "renders HTML attributes as attrs" (fun () ->
      let html = <div class'="flex" id="x1" /> |> render in
      expect html |> to_equal_string {|<div class="flex" id="x1"></div>|}
    );

    it "renders custom tags and custom attributes" (fun () ->
      let html = <custom-tag with-custom-arg="abc" /> |> render in
      expect html
      |> to_equal_string {|<custom-tag with-custom-arg="abc"></custom-tag>|}
    );

    it "renders hyphenated HTML attributes directly" (fun () ->
      let edit_href = "/positions/1/edit" in
      let name = "Manager" in
      let html =
        <a href=(edit_href) aria-label=("Edytuj stanowisko " ^ name) data-testid="edit-link">
          (Html.txt "Edit")
        </a>
        |> render
      in
      expect html
      |> to_equal_string
           {|<a href="/positions/1/edit" aria-label="Edytuj stanowisko Manager" data-testid="edit-link">Edit</a>|}
    );

    it "renders boolean attributes" (fun () ->
      let html = <input type="text" required /> |> render in
      expect html |> to_equal_string {|<input type="text" required></input>|}
    );

    it "keeps explicit attrs compatible" (fun () ->
      let html = <div attrs=[("data-x", "1")] class'="flex" /> |> render in
      expect html |> to_equal_string {|<div data-x="1" class="flex"></div>|}
    );

    it "routes on_* attributes to handlers, not attrs" (fun () ->
      let html = <button on_click=()>(Html.txt "go")</button> |> render in
      expect html |> to_equal_string {|<button>go</button>|}
    );

    it "desugars Msg handlers (on_click / on_submit / on_blur / on_focus / on_dblclick)" (fun () ->
      let html =
        <div on_click=() on_submit=() on_blur=() on_focus=() on_dblclick=()>
          (Html.txt "x")
        </div>
        |> render
      in
      expect html |> to_equal_string {|<div>x</div>|}
    );

    it "desugars On_key handlers (on_keydown / on_keyup / on_keypress)" (fun () ->
      let handle_key _ = () in
      let html =
        <input on_keydown=handle_key on_keyup=handle_key on_keypress=handle_key />
        |> render
      in
      expect html |> to_equal_string {|<input></input>|}
    );

    it "desugars On_value handlers (on_input / on_change)" (fun () ->
      let handle_value _ = () in
      let html = <input on_input=handle_value on_change=handle_value /> |> render in
      expect html |> to_equal_string {|<input></input>|}
    );

    it "accepts parenthesized inline fun in on_* attributes" (fun () ->
      let html =
        <input on_input=(fun v -> ignore v; ()) on_change=(fun v -> ignore v; ()) />
        |> render
      in
      expect html |> to_equal_string {|<input></input>|}
    );

    it "accepts parenthesized if/match and fun in attribute values" (fun () ->
      let html =
        <div
          id=(if true then "a" else "b")
          data-x=(match Some 1 with Some n -> string_of_int n | None -> "0")
          title=((fun s -> s) "hello")
        />
        |> render
      in
      expect html
      |> to_equal_string {|<div id="a" data-x="1" title="hello"></div>|}
    );

    it "desugars unknown on_* to the On_event fallback" (fun () ->
      let handle_event _ = None in
      let html = <div on_wheel=handle_event on_custom_thing=handle_event>(Html.txt "x")</div> |> render in
      expect html |> to_equal_string {|<div>x</div>|}
    );

    it "renders bare-string children as escaped text" (fun () ->
      let html = <p>"hi & bye"</p> |> render in
      expect html |> to_equal_string {|<p>hi &amp; bye</p>|}
    )
  );

  run ~source_file:__FILE__ () |> exit_with_result

