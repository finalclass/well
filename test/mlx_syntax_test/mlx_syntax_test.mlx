open Well_test

let render (`Html v : _ Html.node) = Html.element_to_string (`Html v)

let () =
  describe "Well MLX syntax" (fun () ->
    it "renders HTML attributes as attrs" (fun () ->
      let html = <div class'="flex" id="x1" /> |> render in
      expect html |> to_equal_string {|<div class="flex" id="x1"></div>|}
    );

    it "renders custom tags and custom attributes" (fun () ->
      let html = <custom-tag with-custom-arg="abc" /> |> render in
      expect html
      |> to_equal_string {|<custom-tag with-custom-arg="abc"></custom-tag>|}
    );

    it "renders hyphenated HTML attributes directly" (fun () ->
      let edit_href = "/positions/1/edit" in
      let name = "Manager" in
      let html =
        <a href=(edit_href) aria-label=("Edytuj stanowisko " ^ name) data-testid="edit-link">
          (Html.txt "Edit")
        </a>
        |> render
      in
      expect html
      |> to_equal_string
           {|<a href="/positions/1/edit" aria-label="Edytuj stanowisko Manager" data-testid="edit-link">Edit</a>|}
    );

    it "renders boolean attributes" (fun () ->
      let html = <input type="text" required /> |> render in
      expect html |> to_equal_string {|<input type="text" required></input>|}
    );

    it "keeps explicit attrs compatible" (fun () ->
      let html = <div attrs=[("data-x", "1")] class'="flex" /> |> render in
      expect html |> to_equal_string {|<div data-x="1" class="flex"></div>|}
    );

    it "routes on_* attributes to handlers, not attrs" (fun () ->
      let click _ = None in
      let html = <button on_click=click>(Html.txt "go")</button> |> render in
      expect html |> to_equal_string {|<button>go</button>|}
    );

    it "renders bare-string children as escaped text" (fun () ->
      let html = <p>"hi & bye"</p> |> render in
      expect html |> to_equal_string {|<p>hi &amp; bye</p>|}
    )
  )
