(executable
 (name pp)
 (package well)
 (public_name well-mlx-pp)
 (modules :standard \ mlx_shim)
 (flags
  (:standard -w -9-67 -open Astlib -open Astlib.Ast_501 -open Mlx_shim))
 (libraries ppxlib ocaml-compiler-libs.shadow menhirLib mlx_shim))

(library
 (name mlx_shim)
 (package well)
 (modules mlx_shim)
 (flags
  (:standard -w -9-67 -open Astlib -open Astlib.Ast_501))
 (libraries ppxlib ocaml-compiler-libs.shadow))

(ocamllex lexer)

(menhir
 (flags
  --lalr
  --dump
  --require-aliases
  -lg=1
  -la=1
  --fixed-exception
  --table
  --strategy
  simplified
  ;; These tokens are declared (and, for COMMENT/DOCSTRING/EOL/LESSSLASH,
  ;; emitted by the lexer) but never appear in a grammar production, so Menhir
  ;; warns that they are unused. They are consumed internally by the lexer's
  ;; comment/docstring-skipping loop or kept for grammar completeness, hence
  ;; kept and silenced here.
  --unused-token COMMENT
  --unused-token DOCSTRING
  --unused-token EOL
  --unused-token GREATERRBRACKET
  --unused-token JSX_LIDENT
  --unused-token JSX_LIDENT_E
  --unused-token LESSSLASH)
 (enabled_if
  (<> %{profile} "release"))
 (mode promote)
 (modules parser))
