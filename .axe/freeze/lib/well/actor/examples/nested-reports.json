{
  "format": 1,
  "name": "nested-reports",
  "version": "1",
  "entry": "start",
  "input_type": "Reports.Request",
  "bindings": {},
  "nodes": {
    "start": {
      "kind": "fork",
      "input_type": "Reports.Request",
      "branches": [
        {
          "name": "bundle",
          "next": "nested"
        },
        {
          "name": "stock",
          "next": "stock"
        }
      ],
      "join": "collect"
    },
    "nested": {
      "kind": "fork",
      "input_type": "Reports.Request",
      "branches": [
        {
          "name": "finance",
          "next": "finance"
        },
        {
          "name": "sales",
          "next": "sales"
        }
      ],
      "join": "inner"
    },
    "finance": {
      "kind": "actor",
      "actor": "Reporter",
      "id": {
        "fixed": "finance"
      },
      "accept": "Generate",
      "emission_mode": "one",
      "outputs": {
        "Produced": "inner"
      },
      "join": null
    },
    "sales": {
      "kind": "actor",
      "actor": "Reporter",
      "id": {
        "fixed": "sales"
      },
      "accept": "Generate",
      "emission_mode": "one",
      "outputs": {
        "Produced": "inner"
      },
      "join": null
    },
    "inner": {
      "kind": "join",
      "item_type": "Reports.Report",
      "batch_type": "Reports.ReportBatch",
      "timeout_ms": 30000,
      "next": "combine"
    },
    "combine": {
      "kind": "actor",
      "actor": "ReportCombiner",
      "id": {
        "fixed": "default"
      },
      "accept": "Combine",
      "emission_mode": "one",
      "outputs": {
        "Produced": "collect"
      },
      "join": null
    },
    "stock": {
      "kind": "actor",
      "actor": "Reporter",
      "id": {
        "fixed": "stock"
      },
      "accept": "Generate",
      "emission_mode": "one",
      "outputs": {
        "Produced": "collect"
      },
      "join": null
    },
    "collect": {
      "kind": "join",
      "item_type": "Reports.Report",
      "batch_type": "Reports.ReportBatch",
      "timeout_ms": 30000,
      "next": "summary"
    },
    "summary": {
      "kind": "actor",
      "actor": "SummaryBuilder",
      "id": {
        "fixed": "default"
      },
      "accept": "Build",
      "emission_mode": "one",
      "outputs": {
        "Built": "done"
      },
      "join": null
    },
    "done": {
      "kind": "end",
      "input_type": "Reports.Summary"
    }
  }
}
