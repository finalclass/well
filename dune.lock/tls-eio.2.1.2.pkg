(version 2.1.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune tls mirage-crypto-rng eio ptime)))

(source
 (fetch
  (url
   https://github.com/mirleft/ocaml-tls/releases/download/v2.1.2/tls-2.1.2.tbz)
  (checksum
   sha256=d51940587bce9475c977c596904c8179dcd784d9ef6dd9afe3e634cca940c9f3)))
