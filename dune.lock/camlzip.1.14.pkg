(version 1.14)

(install
 (all_platforms
  (run %{make} install)))

(build
 (all_platforms ((action (run %{make} all)))))

(depends
 (all_platforms
  (ocaml ocamlfind conf-zlib)))

(source
 (fetch
  (url https://github.com/xavierleroy/camlzip/archive/refs/tags/v1.14.tar.gz)
  (checksum
   sha512=b623efc5c5cfc28bad54dcb74f3d08e8cc4b9216d739e23cf3886d2490ef78c518ec37a344121fe1dab0a40e61b5c6e9908c8f12305a0754aaf9278a32c1dba6)))
