(version 1.4)

(build
 (all_platforms
  ((action (run dune build -p %{pkg-self:name} -j %{jobs} @install)))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (dune eio_linux eio_posix))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (dune eio_posix))))

(source
 (fetch
  (url
   https://github.com/ocaml-multicore/eio/releases/download/v1.4/eio-1.4.tbz)
  (checksum
   sha256=ba11ad486f492130dbb486f2b3bdc4905643f10016806ddf86e9a34e4346aaa5)))
