(version 2.1.3)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml
   dune
   mirage-crypto
   mirage-crypto-ec
   mirage-crypto-pk
   mirage-crypto-rng
   x509
   domain-name
   fmt
   kdf
   logs
   ipaddr
   ohex
   digestif
   ptime)))

(source
 (fetch
  (url
   https://github.com/mirleft/ocaml-tls/releases/download/v2.1.3/tls-2.1.3.tbz)
  (checksum
   sha512=0cee10cc41010b27eb303da7664021e02540f75363b3c472b27828913920da35502c776ce894e649fe80e6828058f8359f13b8f33848454ba5fa5ac0bba8e33d)))
