(version 2.2.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (dune ocaml dune-configurator eqaf mirage-crypto-rng digestif)))

(source
 (fetch
  (url
   https://github.com/mirage/mirage-crypto/releases/download/v2.2.0/mirage-crypto-2.2.0.tbz)
  (checksum
   sha256=4b87091b6a77843bf97a74aae2e7da21310307ff7d2105712c4369680122d80a)))
